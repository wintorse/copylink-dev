{
  "name": "copylink.dev",
  "version": "1.14.1",
  "description": "Browser extension that provides shortcuts to copy links. On supported sites, it creates Slack emoji-enhanced links.",
  "homepage": "https://github.com/wintorse/copylink-dev#readme",
  "bugs": {
    "url": "https://github.com/wintorse/copylink-dev/issues"
  },
  "license": "MIT",
  "author": "wintorse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wintorse/copylink-dev.git"
  },
  "type": "module",
  "main": "src/background.ts",
  "scripts": {
    "build": "tsc && vite build --emptyOutDir && vite build --config vite.content.config.js",
    "build:with-host-permissions": "tsc && vite build --emptyOutDir --mode with-host-permissions && vite build --config vite.content.config.js --mode with-host-permissions",
    "build-firefox": "tsc && vite build --emptyOutDir --minify false --mode firefox && vite build --config vite.content.config.js --minify false --mode firefox",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "pnpm build && playwright test",
    "test:headed": "pnpm build && playwright test --headed",
    "test:unit": "vitest run",
    "test:firefox-content": "pnpm build-firefox && playwright test --config playwright.firefox.config.ts",
    "test:chromium-shortcuts": "pnpm build && playwright test --config playwright.chromium-shortcuts.config.ts",
    "test:firefox-addon": "pnpm build-firefox && playwright test --config playwright.firefox-addon.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.5",
    "@types/selenium-webdriver": "^4.35.7",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
